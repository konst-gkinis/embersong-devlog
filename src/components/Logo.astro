---
const baseUrl = import.meta.env.BASE_URL;
---

<style>
  img {
    display: block;
    width: 75px;
  }

  @media screen and (max-width: 520px) {
    img {
      display: none;
    }
  }
</style>

<a href="/">
  <img
    alt="Blog Logo"
    src={`${baseUrl}assets/logo.webp`}
    width="75"
    height="50"
  />
</a>
