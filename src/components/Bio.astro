---
const baseUrl = import.meta.env.BASE_URL;
---

<div>
  <img
    src={`${baseUrl}assets/profile_pic.jpg`}
    alt="Headshot of Konst Gkinis"
  />
  <p>
    Hi, I'm <strong>Konst</strong>. I love games and the social aspect they
    bring. I don't care much about socials, but you can find me on <a
      href="https://github.com/konst-gkinis"
      target="_blank">GitHub</a
    >.
  </p>
</div>

<style>
  div {
    align-items: center;
    display: flex;
  }

  img {
    width: 100px;
    height: 100px;
    border-radius: 100px;
    display: block;
    margin-right: 20px;
  }

  p {
    font-size: 1.125rem;
  }
</style>
